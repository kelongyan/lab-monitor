# Python & Virtual Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/

# Weights & Models
*.pt
*.onnx
*.engine
*.tflite

# Local Media & Datasets (Do not commit video files)
videos/*
