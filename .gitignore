# Python & Virtual Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/

# Weights & Models
*.pt
*.onnx
*.engine
*.tflite

# Local Media & Datasets (Do not commit video files)
videos/*
!videos/.gitkeep

# Output Logs, Screenshots & Cache
outputs/*
!outputs/.gitkeep
*.log
*.jsonl

# IDE & OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Route Archives & Reference PDFs (large binaries)
*.7z
docs/*.pdf
docs/routes/*.pdf

# 现场点位表：含真实摄像头 IP（172.20.x.x）、图纸点号与物理位置对照。
# 本仓库在 GitHub 上是公开的，这类设施网络信息不入库；它是相机拓扑的唯一依据，
# 请自行留存（压缩包 常规路线.7z / 随机路线.7z 内也有一份）。
docs/*.xlsx

# Agent Workspace
.workbuddy/

# 客户平面图渲染底图：与 docs/*.xlsx 同级敏感（设施图纸，公开仓库不入库）
assets/floorplan/
